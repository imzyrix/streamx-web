    "type": "git",
    "url": "git+https://github.com/imzyrix/streamx-web.git"
  },
  "homepage": "https://github.com/imzyrix/streamx-web#readme",
  "bugs": {
    "url": "https://github.com/imzyrix/streamx-web/issues"
  },
